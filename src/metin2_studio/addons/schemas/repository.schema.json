{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:metin2-studio:repository:1",
  "title": "Metin2 Studio repository index version 1",
  "type": "object",
  "required": ["schema_version", "name", "publisher", "packages"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "publisher": {"type": "string", "minLength": 1, "maxLength": 128},
    "packages": {"type": "array", "maxItems": 200, "items": {
      "type": "object", "required": ["id", "name", "description", "releases"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "description": {"type": "string", "minLength": 1, "maxLength": 4000},
        "author": {"type": "string", "minLength": 1, "maxLength": 256},
        "category": {"type": "string", "minLength": 1, "maxLength": 128},
        "releases": {"type": "array", "minItems": 1, "maxItems": 50, "items": {
          "type": "object", "required": ["version", "url", "sha256", "bytes"],
          "properties": {
            "version": {"type": "string", "minLength": 5, "maxLength": 128},
            "url": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 4096},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "bytes": {"type": "integer", "minimum": 1, "maximum": 69206016},
            "withdrawn": {"type": "boolean", "default": false},
            "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
            "release_notes": {"type": "string", "minLength": 1, "maxLength": 4000}
          }
        }}
      }
    }}
  }
}
