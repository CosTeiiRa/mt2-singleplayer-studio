{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metin2 Studio GitHub collection",
  "type": "object",
  "required": ["schema_version", "name", "publisher", "addons"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "publisher": {"type": "string", "minLength": 1, "maxLength": 128},
    "addons": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "path"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"},
          "path": {"type": "string", "minLength": 1, "maxLength": 229}
        }
      }
    }
  }
}
