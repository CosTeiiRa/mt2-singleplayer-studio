{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:metin2-addon-hub:addon:1",
  "title": "Metin2 Add-on Hub manifest version 1",
  "type": "object",
  "required": ["schema_version", "id", "name", "version", "description", "author", "category", "kind", "entry", "requires", "conflicts", "capabilities", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "api_version": {"type": "integer", "enum": [1, 2], "default": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "author": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "kind": {"const": "client-python"},
    "entry": {"type": "string", "pattern": "^m2hub_addons\\.[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*$"},
    "requires": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dependency_versions": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 256}},
    "conflicts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "files": {"type": "array", "minItems": 1, "maxItems": 2048, "items": {"type": "object", "required": ["source", "target", "sha256"], "properties": {
      "source": {"type": "string", "minLength": 1},
      "target": {"type": "string", "pattern": "^m2hub_addons/"},
      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }}},
    "settings": {"type": "object"},
    "settings_schema": {"type": "object"},
    "compatibility": {"type": "object", "properties": {
      "client_versions": {"type": "array", "items": {"type": "string"}},
      "server_versions": {"type": "array", "items": {"type": "string"}},
      "profile_ids": {"type": "array", "items": {"type": "string"}},
      "experimental": {"type": "boolean"}
    }},
    "license": {"type": "string"},
    "release_notes": {"type": "string"}
  }
}
